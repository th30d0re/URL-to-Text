# Video-to-Text Application Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# TRANSCRIPTION MODE SETTINGS
# =============================================================================

# Transcription mode: 'online' (OpenAI API) or 'offline' (local Whisper)
# Online mode requires OPENAI_API_KEY and uses OpenAI's cloud API
# Offline mode uses local Whisper models (requires openai-whisper package)
TRANSCRIPTION_MODE=online

# =============================================================================
# ONLINE MODE CONFIGURATION (OpenAI API)
# =============================================================================

# OpenAI API Key (required only for online mode)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# OFFLINE MODE CONFIGURATION (Local Whisper)
# =============================================================================

# Whisper model size for offline transcription
# Options: tiny, base, small, medium, large, large-v2, large-v3
# - tiny: ~39 MB, fastest, lowest accuracy
# - base: ~74 MB, good balance of speed and accuracy (recommended)
# - small: ~244 MB, better accuracy, slower
# - medium: ~769 MB, high accuracy, much slower
# - large: ~1550 MB, highest accuracy, very slow
# - large-v2: ~1550 MB, improved large model
# - large-v3: ~1550 MB, latest large model with best accuracy
OFFLINE_MODEL_NAME=base

# Device selection for Whisper model inference
# Options: cpu, cuda, auto
# - cpu: Use CPU only (works everywhere, slower)
# - cuda: Use GPU if available (faster, requires CUDA-compatible GPU)
# - auto: Automatically choose best available device
WHISPER_DEVICE=auto

# Optional: Custom directory for storing Whisper models
# If not set, models will be stored in the default location
# WHISPER_MODELS_DIR=/path/to/whisper/models

# =============================================================================
# GENERAL APPLICATION SETTINGS
# =============================================================================

# Directory for temporary files (defaults to system temp directory)
TEMP_DIR=/tmp/video_to_text

# Whether to keep intermediate files after processing (default: false)
KEEP_INTERMEDIATE_FILES=false

# Maximum file size for OpenAI Whisper API (in MB)
# Note: This limit only applies to online mode
# Offline mode can handle much larger files
MAX_FILE_SIZE_MB=25

# Audio segment duration for large files (in seconds)
# Files larger than MAX_FILE_SIZE_MB will be split into segments
SEGMENT_DURATION_SECONDS=600

# Audio transcoding bitrate (in kbps)
# Higher bitrate = better quality but larger files
TRANSCODE_BITRATE_KBPS=64

# =============================================================================
# SYSTEM REQUIREMENTS FOR OFFLINE MODE
# =============================================================================

# RAM Requirements by Model:
# - tiny: ~1 GB RAM
# - base: ~1 GB RAM  
# - small: ~2 GB RAM
# - medium: ~5 GB RAM
# - large: ~10 GB RAM
# - large-v2: ~10 GB RAM
# - large-v3: ~10 GB RAM

# GPU Requirements (if using CUDA):
# - CUDA-compatible GPU with at least 4GB VRAM recommended
# - For large models, 8GB+ VRAM recommended
# - CPU fallback available if GPU is insufficient

# Storage Requirements:
# - Model files are downloaded once and cached locally
# - Total storage needed: ~2-3 GB for all models
# - Individual model sizes listed above
